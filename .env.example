# Public — safe to expose in browser. Used by the anon Supabase client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — bypasses RLS. Never expose to the browser.
# Used by scripts (seed, reset) and by server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection — used by scripts/migrate.ts to apply DDL.
# Use the Session pooler URI from Dashboard → Settings → Database → Connection string.
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# OpenAI — server-only, used for natural-language entity extraction.
OPENAI_API_KEY=sk-proj-...
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_SYNTHESIS_MODEL=gpt-5
OPENAI_RERANK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter — server-only. Chat model env vars above accept namespaced ids
# ("deepseek/deepseek-v4-flash"); those route through OpenRouter and need
# this key. Embeddings and transcription always stay on OpenAI.
OPENROUTER_API_KEY=sk-or-v1-...

# Shared secret protecting /api/jobs/* endpoints. Generate with `openssl rand -hex 32`.
JOB_SECRET=replace-me

# App auth — single global password. The middleware blocks every page/api
# unless the request carries a valid `neonet-auth` cookie or a valid
# `x-job-secret` header.
APP_PASSWORD=replace-me
# Random 32+ byte hex secret used to sign the auth cookie. Generate with
# `openssl rand -hex 32`. Rotating it logs everyone out.
JWT_SECRET=replace-me
# Set to "true" to short-circuit the middleware and let every request
# through. Emergency valve only — leave unset in production.
# BYPASS_AUTH=true
